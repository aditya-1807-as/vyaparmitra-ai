# ============================================================================
# VYAPARMITRA AI - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Database Configuration (Optional: defaults to built-in realistic persistence store)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vyaparmitra_db

# Google Gemini API Key (Optional: when provided, unlocks direct Gemini 1.5 Flash generation; otherwise, uses rule-based analytical retail intelligence fallback)
GEMINI_API_KEY=

# JWT Secret Key for Session Authentication
JWT_SECRET=vyaparmitra_production_secret_key_2026_jwt

